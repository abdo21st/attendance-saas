# ===================================================
# ZKTeco Attendance Management System - Environment Variables
# انسخ هذا الملف إلى .env وعبّئ القيم الصحيحة
# ===================================================

# قاعدة البيانات PostgreSQL (مطلوب)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# مفتاح تشفير جلسات Flask (مطلوب - غيّره لقيمة عشوائية قوية)
SECRET_KEY=generate-a-random-long-string-here

# توكن السوبر أدمن للتحكم بالمنصة (مطلوب)
SUPER_ADMIN_TOKEN=your-secure-super-admin-token

# إعدادات إضافية (اختياري)
# FLASK_ENV=production
# DEBUG=false
